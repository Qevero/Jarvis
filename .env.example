# Copy to .env.local for local development. In production set these in
# Netlify → Site configuration → Environment variables. Never commit real values.

# Supabase → Project Settings → API (London region project)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# The only account allowed into Jarvis (dashboard and Claude connector)
JARVIS_OWNER_EMAIL=you@example.com

# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Keep a copy in your password manager: losing it makes encrypted vault
# fields (UTR, bank details) unreadable.
VAULT_ENCRYPTION_KEY=

# Optional. Defaults to Netlify's URL variable.
# JARVIS_SITE_URL=https://jarvis-qevero.netlify.app

# Optional. Exact OAuth redirect URIs the consent screen may approve.
# OAUTH_ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback

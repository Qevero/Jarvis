# Copy to .env.local for local development. In production set these in
# Netlify → Site configuration → Environment variables. Never commit real values.
# Full descriptions: README.md → Environment variables.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Scheduled jobs only (never NEXT_PUBLIC_)
SUPABASE_SECRET_KEY=

JARVIS_OWNER_EMAIL=you@example.com
# openssl rand -base64 32  — back it up in your password manager
VAULT_ENCRYPTION_KEY=
# openssl rand -hex 32
CRON_SECRET=
# JARVIS_SITE_URL=https://jarvis-qevero.netlify.app

# Xero (developer.xero.com → Web app; redirect /api/integrations/xero/callback)
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# XERO_SCOPES=

# Microsoft (Entra app, personal accounts; redirect /api/integrations/microsoft/callback)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=consumers

# Qevero CRM connector (integrations/qevero-crm/jarvis_connector.sql)
CRM_SUPABASE_URL=
CRM_SUPABASE_PUBLISHABLE_KEY=
CRM_CONNECTOR_TOKEN=
# CRM_APP_URL=

# Optional
COMPANIES_HOUSE_API_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:qevero@outlook.com
# OAUTH_ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback
